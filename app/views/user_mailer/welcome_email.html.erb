<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <style>
      body {
        font-family: sans-serif;
        background-color: #111827;
        color: #e5e7eb;
        padding: 2rem;
      }

      .btn {
        display: inline-block;
        margin-top: 1.5rem;
        padding: 0.75rem 1.25rem;
        background-color: #3b82f6;
        color: white;
        text-decoration: none;
        border-radius: 0.375rem;
      }

      .btn:hover {
        background-color: #2563eb;
      }
    </style>
  </head>
  <body>
    <h1>Welcome to WeAreMusik, <%= @user.username %>!</h1>

    <p>
      Thanks for signing up. We're thrilled to have you on board.
    </p>

    <p>
      You can now explore tracks, albums, and artists curated by the community.
    </p>

    <a href="<%= root_url %>" class="btn">Go to the site</a>

    <p style="margin-top: 2rem; font-size: 0.875rem; color: #9ca3af;">
      If you did not sign up, please ignore this message.
    </p>
  </body>
</html>
