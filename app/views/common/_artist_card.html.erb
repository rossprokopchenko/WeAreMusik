<%= link_to search_artist_path(artist.gid),
  class: "flex flex-col rounded-xl flex-1 min-w-0 hover:bg-gray-800 max-w-[200px]" do %>

  <div
    data-controller="image-loader"
    data-image-loader-url="<%= url_for(artist.image) if artist.image.attached? %>"
    data-image-loader-alt="<%= artist.name %> image"
    data-image-loader-target="container"
    class="w-full relative rounded-xl overflow-hidden bg-gray-800"
    style="padding-top: 100%;"
  >
    <div class="cover-skeleton rounded-xl bg-gray-700 animate-pulse absolute inset-0"></div>
  </div>

  <div class="py-2 items-center">
    <div class="text-sm text-white font-semibold truncate text-center">
      <%= artist.name %>
    </div>
  </div>
<% end %>
