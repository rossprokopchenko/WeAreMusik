<%= turbo_stream_from "release_#{@release.gid}_cover_art" if @release %>

<%
  displayable_release_labels = @release.release_labels.reject do |rl|
    rl.label.present? && rl.label.name == "[no label]"
  end
%>

<div class="flex flex-col w-full">

    <div class="flex flex-col mt-4 rounded-l-xl bg-gray-900 border border-gray-700">
        <div class="flex flex-row">
            <div class="cover-art-display">
                <%# Use a turbo_frame_tag to allow dynamic updates of the image %>
                <%# The ID should be unique, e.g., based on the release ID %>
                <%= turbo_frame_tag "release_cover_art_#{@release.gid}" do %>
                    <%# Render the partial here, passing the @release object as 'release' local %>
                    <%= render partial: 'search/elements/cover_art_frame', locals: { release: @release } %>
                <% end %>
            </div>

            <div class="flex flex-col items-center my-auto w-full">
                <div class="text-xl text-center font-semibold">
                    <%= @release.name %>
                </div>
                <div class="text-lg text-gray-400 text-center">
                    <%= @release.artist_credit&.name %>
                </div>
            </div>

            <div class="flex flex-col ml-auto text-right p-4 w-1/3">
                
                <div>
                    <%= @release.release_group&.primary_type&.name %> 
                    
                    <% if @release.release_status&.name %>
                        (<%= @release.release_status&.name %>)
                    <% end %>
                </div>

                <div class="mt-auto">
                    <div>
                        <% @release.release_countries.take(1).each do |release_country|%>
                            <div class="text-md text-gray-400">
                                <%= month_to_str(release_country.date_month) %> <%= release_country.date_year %>
                            </div>
                        <% end %>
                        <% @release.release_countries.take(3).each do |release_country| %>
                            <div class="text-md text-gray-400">
                                <%= release_country.country_area&.name %>
                            </div>
                        <% end %>
                    </div>
                    <% if displayable_release_labels.present? %>
                        <div class="text-md text-gray-400">
                            <%= label_str(displayable_release_labels) %>
                        </div>
                    <% else %>
                        <div class="text-md text-gray-400">
                            No release labels
                        </div>
                    <% end %>
                </div>
            </div>
        </div>

        <div class="p-8 mx-auto flex flex-row gap-4 items-center justify-between">
            <% if authenticated? %>
                <%= turbo_frame_tag "release_save_button_#{@release.id}" do %>
                    <%= render partial: "search/elements/release_save_button", locals: { release: @release } %>
                <% end %>
            <% end %>

            <% artist_credit_names = @release.artist_credit&.artist_credit_names || [] %>

            <% if artist_credit_names.size == 1 %>
                <% artist = artist_credit_names.first.artist %>

                <%= link_to search_artist_path(artist.gid), method: :post, class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded inline-flex items-center gap-x-2" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-fill" viewBox="0 0 16 16">
                        <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                    </svg>

                    <span class="text-white">Go To Artist</span>
                <% end %>

            <% elsif artist_credit_names.size > 1 %>
                
                <div class="flex flex-col gap-2">
                    <% artist_credit_names.each do |acn| %>
                        <%= link_to search_artist_path(acn.artist.gid), method: :post, class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded inline-flex items-center gap-x-2" do %>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-fill" viewBox="0 0 16 16">
                                <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                            </svg>

                            <span class="text-white"><%= acn.artist.name %></span>
                        <% end %>
                    <% end %>
                </div>
            <% end %>

            <% if @external_urls.any? %>
                <div data-controller="show-album" class="relative inline-block text-left">
                
                    <button data-action="click->show-album#toggle"
                            class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded inline-flex items-center gap-x-2 cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                            class="bi bi-link-45deg" viewBox="0 0 16 16">
                            <path d="M4.715 6.542a3 3 0 0 1 4.243 0l.708.707a1 1 0 0 0 1.414-1.414l-.707-.708a5 5 0 0 0-7.071 0l-1.414 1.415a5 5 0 0 0 0 7.07l.707.708a1 1 0 0 0 1.414-1.414l-.707-.707a3 3 0 0 1 0-4.243l1.413-1.414z"/>
                            <path d="M6.542 4.715a3 3 0 0 1 4.243 0l1.414 1.414a3 3 0 0 1 0 4.243l-1.414 1.414a1 1 0 0 0 1.414 1.414l1.414-1.414a5 5 0 0 0 0-7.07L12.2 3.3a5 5 0 0 0-7.07 0 1 1 0 0 0 1.414 1.414l.707-.707z"/>
                        </svg>
                        <span>External Links</span>
                    </button>

                    <div data-show-album-target="externalLinks" class="hidden absolute mt-2 w-56 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded shadow-lg z-50">
                        <% @external_urls.each do |url| %>
                        <%= link_to URI.parse(url.url).host.sub(/^www\./, '').split('.').first.capitalize, url.url, target: "_blank",
                                class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700" %>
                        <% end %>
                    </div>
                </div>
            <% end %>


        </div>

    </div>

    <div class="mt-8 p-8 max-h-96 overflow-y-auto min-w-4xl max-w-full mx-auto bg-gray-900 border border-gray-700 rounded-xl">
        <% @tracks.group_by { |track| track.medium.position }.each do |disc_number, tracks| %>
            <div class="mb-6">
                <% if @tracks.group_by { |track| track.medium.position }.size > 1 %>
                    <h2 class="text-lg font-semibold text-white mb-4">Disc <%= disc_number %></h2>
                <% end %>

                <div class="columns-4 gap-0 space-y-1">
                    <% tracks.each do |track| %>
                        <div class="break-inside-avoid overflow-hidden">
                            <a href="<%= search_track_path(track.gid) %>">
                                <div class="px-14 py-2 hover:bg-gray-800 rounded-sm">
                                    <%= track.position %>. <%= track.name %>
                                </div>
                            </a>
                        </div>
                    <% end %>
                </div>
            </div>
        <% end %>
    </div>

    
</div>