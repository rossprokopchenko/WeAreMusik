<%= turbo_frame_tag "track_like_button_#{track.id}" do %>
  <% if current_user.liked_track_id?(track.id) %>
    <%= button_to unlike_track_path(gid: track.gid),
          method: :delete,
          class: "bg-red-600 hover:bg-red-500 text-white border border-red-700 px-4 py-2 rounded cursor-pointer inline-flex items-center gap-x-2" do %>
      
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
        <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
      </svg>
      <span class="text-white">Unlike Track</span>
    <% end %>
  <% else %>
    <%= button_to like_track_path(gid: track.gid),
          method: :post,
          class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded cursor-pointer inline-flex items-center gap-x-2" do %>
      
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-heart-fill align-middle" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314"/>
      </svg>
      <span class="text-white">Like Track</span>
    <% end %>
  <% end %>
<% end %>
