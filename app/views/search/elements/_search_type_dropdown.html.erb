<div data-controller="dropdown" class="relative inline-block w-32 z-50">
  <!-- Dropdown Button -->
  <button
    type="button"
    data-action="click->dropdown#toggle"
    class="appearance-none w-full border cursor-pointer border-gray-700 rounded px-4 py-2 text-gray-200 bg-gray-800 hover:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-600 flex justify-between items-center"
  >
    <span data-dropdown-target="label">
      <%= current_search_by.capitalize %>
    </span>
    <svg class="h-5 w-5 text-gray-400 ml-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Options Menu -->
  <ul
    data-dropdown-target="menu"
    class="absolute z-10 mt-2 w-full bg-gray-900 rounded-md shadow-lg ring-1 ring-black ring-opacity-5 hidden"
  >
    <% ["artists", "albums", "tracks", "users"].each do |type| %>
      <li>
        <button
          type="button"
          data-action="click->dropdown#select"
          data-value="<%= type %>"
          class="w-full text-left px-4 py-2 text-gray-200 hover:bg-gray-700 rounded-md cursor-pointer <%= 'bg-gray-700' if current_search_by == type %>"
        >
          <%= type.capitalize %>
        </button>
      </li>
    <% end %>
  </ul>
</div>
