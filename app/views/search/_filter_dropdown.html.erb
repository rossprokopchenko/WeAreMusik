<div data-controller="search" class="relative inline-block w-32">

  <!-- Filter Button (Styled like dropdown) -->
  <button
    type="button"
    data-action="click->search#toggleDropdown"
    class="appearance-none w-full cursor-pointer border border-gray-700 rounded px-4 py-2 text-gray-200 bg-gray-800 hover:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-600 inline-flex justify-between items-center"
  >
    Filters
    <svg class="h-5 w-5 text-gray-400 ml-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Panel -->
  <div
    data-search-target="menu"
    class="origin-top-left absolute left-0 mt-2 w-56 rounded-md shadow-lg bg-gray-900 ring-1 ring-black ring-opacity-5 p-4 z-50 hidden"
  >
    <div class="space-y-2">
      <!-- Canonical Filter Button -->
      <button
        type="button"
        data-filter="canonical"
        data-search-target="filterCanonical"
        data-action="click->search#toggleFilter"
        class="w-full text-left px-4 py-2 text-sm rounded bg-gray-800 text-gray-200 border border-green-400 flex justify-between items-center cursor-pointer"
      >
        <span>Canonical</span>
        <span data-search-target="filterIcon" class="ml-2 text-green-400">
          <i class="bi bi-check-lg"></i>
        </span>
      </button>


    </div>
  </div>
</div>
