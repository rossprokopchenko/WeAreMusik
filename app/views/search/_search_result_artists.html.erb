
<div>
    <div class="relative overflow-y-auto border border-gray-200 dark:border-gray-700 md:rounded-lg bg-white dark:bg-gray-900" style="height: calc(100vh - 300px);">

        <table class="min-w-full table-fixed divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="sticky top-0 z-10 bg-gray-50 dark:bg-gray-800">
                <tr>
                    <th scope="col" class="w-1/3 py-3.5 px-4 text-sm font-normal text-left text-gray-500 dark:text-gray-400">
                        Artist
                    </th>
                    <th scope="col" class="w-1/3 py-3.5 px-4 text-sm font-normal text-left text-gray-500 dark:text-gray-400">
                        Comment
                    </th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200 dark:divide-gray-700 dark:bg-gray-900">
                <% if results.any? %>
                    <% results.each do |artist| %>
                        <tr 
                            data-controller="click-row"
                            data-click-row-url-value="<%= search_artist_path(artist.gid) %>"
                            data-action="click->click-row#navigate"
                            class="transition-colors duration-100 hover:bg-gray-800 h-16">
                            <td class="px-4 py-4 font-medium text-gray-200">
                                <div>
                                    <%= artist.name %>
                                </div>
                            </td>
                            <td class="px-4 py-4 font-medium text-gray-200">
                                <% if artist.comment? %>
                                <div>
                                    <%= artist.comment %>
                                </div>
                                <% else %>
                                <div class="text-gray-500 dark:text-gray-400">
                                    -
                                </div>
                                <% end %>
                            </td>
                        </tr>
                    <% end %>
                <% else %>
                    <tr>
                        <td colspan="4" class="px-4 py-4 text-gray-500 dark:text-gray-400">
                            No artists found with the set filter.
                        </td>
                    </tr>
                <% end %>
            </tbody>
        </table>

    </div>

    <div class="pagination mt-3">
        <%= paginate results, renderer: TailwindKaminariRenderer %>
    </div>
</div>