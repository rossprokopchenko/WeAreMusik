
<div>
    <div class="relative overflow-y-auto border border-gray-200 dark:border-gray-700 md:rounded-lg bg-white dark:bg-gray-900" style="height: calc(100vh - 300px);">

        <table class="min-w-full table-fixed divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="sticky top-0 z-10 bg-gray-50 dark:bg-gray-800">
                <tr>
                    <th scope="col" class="w-1/4 py-3.5 px-4 text-sm font-normal text-left rtl:text-right text-gray-500 dark:text-gray-400">
                        Artist
                    </th>
                    <th scope="col" class="w-1/3 py-3.5 px-4 text-sm font-normal text-left rtl:text-right text-gray-500 dark:text-gray-400">
                        Name
                    </th>
                    <th scope="col" class="w-full py-3.5 px-4 text-sm font-normal text-left rtl:text-right text-gray-500 dark:text-gray-400">
                        Status
                    </th>
                    <th scope="col" class="relative py-3.5 px-4">
                        <span class="sr-only">Details</span>
                    </th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200 dark:divide-gray-700 dark:bg-gray-900">
                <% if @paginated_results.any? %>
                    <% @paginated_results.each do |album| %>
                        <tr class="transition-colors duration-100 hover:bg-gray-800">
                            <td class="px-4 py-4 font-medium text-gray-200">
                                <div>
                                    <%= album.artist_credit&.name %>
                                </div>
                            </td>
                            <td class="max-w-1/3 px-4 py-4 font-medium text-gray-200">
                                <div>
                                    <%= album.name %>
                                </div>
                            </td><td class="max-w-1/3 px-4 py-4 font-medium text-gray-200">
                                <div>
                                    <%= album.release_status&.name %>
                                </div>
                            </td>
                            
                            <td class="px-8 py-4 font-medium whitespace-nowrap text-gray-200 text-right">
                                <a href="<%= search_album_path(album.gid) %>" target="_blank">
                                    <button style="padding: 10px; width: 50px; height: 50px;"
                                        class="px-4 py-2 font-medium text-gray-600 sm:px-6 dark:text-gray-300"
                                    > 
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            width="100%"       height="100%"      fill="currentColor"
                                            class="bi bi-question-circle"
                                            viewBox="0 0 16 16">
                                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                            <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94"/>
                                        </svg>
                                    </button>
                                </a>
                            </td>
                        </tr>
                    <% end %>
                <% else %>
                    <tr>
                        <td colspan="4" class="px-4 py-4 text-gray-500 dark:text-gray-400">
                            No albums found.
                        </td>
                    </tr>
                <% end %>
            </tbody>
        </table>

    </div>

    <div class="pagination mt-3">
        <%= paginate results, renderer: TailwindKaminariRenderer %>
    </div>
    
</div>