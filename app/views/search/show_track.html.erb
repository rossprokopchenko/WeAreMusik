
<%= turbo_stream_from "release_#{@release.gid}_cover_art" if @release %>

<%
  displayable_release_labels = @track.release_labels.reject do |rl|
    rl.label.present? && rl.label.name == "[no label]"
  end
%>

<div class="flex flex-col w-full">

    <div class="flex flex-col mt-4 rounded-l-xl dark:bg-gray-900 border border-gray-200 dark:border-gray-700">
        <div class="flex flex-row">
            <div class="cover-art-display">
                <%# Use a turbo_frame_tag to allow dynamic updates of the image %>
                <%# The ID should be unique, e.g., based on the release ID %>
                <%= turbo_frame_tag "release_cover_art_#{@release.gid}" do %>
                    <%# Render the partial here, passing the @release object as 'release' local %>
                    <%= render partial: 'search/cover_art_frame', locals: { release: @release } %>
                <% end %>
            </div>

            <div class="flex flex-col items-center my-auto w-full">
                <div class="text-xl text-center font-semibold">
                    <%= @track.name %>
                </div>
                <div class="text-lg text-gray-400 text-center">
                    <%= @track.artist_credit&.name %>
                </div>
                <%# <div class="text-center">
                </div> %>
            </div>

            <div class="flex flex-col ml-auto text-right p-4 w-1/3">
                
                <% if @track.medium&.format&.id == 12 %>
                    <div>
                        Available online (<%= @track.medium&.format&.name %>)
                    </div>
                <% end %>
                
                <% if @track.recording&.video %>
                    <div>
                        Has music video
                    </div>
                <% end %>

                <div class="mt-auto">
                    <div>
                        <% @track.release&.release_countries.take(1).each do |release_country|%>
                            <div class="text-md text-gray-400">
                                <%= month_to_str(release_country.date_month) %> <%= release_country.date_year %>
                            </div>
                        <% end %>
                        <% @track.release&.release_countries.take(3).each do |release_country| %>
                            <div class="text-md text-gray-400">
                                <%= release_country.country_area&.name %>
                            </div>
                        <% end %>
                    </div>
                    <% if displayable_release_labels.present? %>
                        <div class="text-md text-gray-400">
                            <%= label_str(displayable_release_labels) %>
                        </div>
                    <% else %>
                        <div class="text-md text-gray-400">
                            No release labels
                        </div>
                    <% end %>
                </div>
            </div>
        </div>

        <div class="p-8 mx-auto flex flex-row gap-4">
            <%= turbo_frame_tag "save_button_#{@track.id}" do %>
                <% unless current_user.tracks.exists?(@track.id) %>
                    <%= button_to like_track_path(@track), method: :post, class: "bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 inline-flex items-center gap-x-2 rounded cursor-pointer" do %>
                        
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-heart-fill align-middle" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314"/>
                        </svg>

                        <span class="text-white">Like Track</span>
                    <% end %>
                <% else %>
                    <span class="text-green-400">Already Liked</span>
                <% end %>
            <% end %>

            <%= link_to search_album_path(@track.release&.gid), method: :post, class: "bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded inline-flex items-center gap-x-2" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-journal-album" viewBox="0 0 16 16">
                    <path d="M5.5 4a.5.5 0 0 0-.5.5v5a.5.5 0 0 0 .5.5h5a.5.5 0 0 0 .5-.5v-5a.5.5 0 0 0-.5-.5zm1 7a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1z"/>
                    <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2"/>
                    <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1z"/>
                </svg>
                <span class="text-white">Go To Album</span>
            <% end %>

            <%= link_to search_artist_path(@track.artist_credit&.gid), method: :post, class: "bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded inline-flex items-center gap-x-2" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-fill" viewBox="0 0 16 16">
                    <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                </svg>
                
                <span class="text-white">Go To Artist</span>
            <% end %>

        </div>
    </div>
</div>