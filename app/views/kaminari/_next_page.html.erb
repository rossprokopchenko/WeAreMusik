<span class="next">
  <% if current_page.last? %>
    <span aria-current="page" class="z-10 border-gray-200 dark:border-gray-700 dark:bg-gray-900 text-gray-100 relative inline-flex items-center px-2 py-2 rounded-r-md border text-sm font-medium">
      <%= raw(t 'views.pagination.next') %>
    </span>
  <% else %>
    <%= link_to raw(t 'views.pagination.next'), url, remote: remote,
      data: { turbo_frame: "search_result_tracks" },
      class: "relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 text-sm font-medium border-gray-200 dark:border-gray-700 dark:bg-gray-900 text-gray-100 hover:bg-gray-800"
    %>
  <% end %>
  
</span>