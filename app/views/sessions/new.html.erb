<div class="mt-20 px-6 w-full">
  
  <div class="bg-gray-800 border border-gray-700 p-16 rounded-xl shadow-md max-w-xl mx-auto">

    <h1 class="text-3xl font-semibold text-gray-100 mb-6 text-center">Sign in</h1>
  
    <%= form_with url: login_path, method: :post, data: { turbo: false }, class: "space-y-5" do |form| %>
      
      <div>
        <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username",
          placeholder: "Username",
          value: params[:username],
          class: "w-full rounded-md border border-gray-600 bg-gray-900 text-gray-100 placeholder-gray-500 focus:ring-2 focus:ring-blue-600 focus:outline-none px-4 py-2 text-sm" %>
      </div>

      <div>
        <%= form.password_field :password, required: true, autocomplete: "current-password",
          placeholder: "Password", maxlength: 72,
          class: "w-full rounded-md border border-gray-600 bg-gray-900 text-gray-100 placeholder-gray-500 focus:ring-2 focus:ring-blue-600 focus:outline-none px-4 py-2 text-sm" %>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-6">

        <div class="flex flex-row w-1/3">
          <%= link_to "Forgot password?", new_password_path,
          class: "text-sm text-gray-400 hover:text-gray-200 underline underline-offset-2" %>
        </div>

        <div class="flex flex-row w-1/3 items-center justify-center">
          <%= form.submit "Sign in", class: "rounded-md bg-blue-600 hover:bg-blue-500 px-4 py-2 text-sm font-medium text-white transition cursor-pointer" %>

        </div>

        <div class="flex flex-row w-1/3 ml-auto justify-end">
          <%= link_to "Sign up", signup_path,
            class: "rounded-md border border-gray-600 px-4 py-2 text-sm text-gray-200 hover:bg-gray-700 transition" %>
        </div>

      </div>


    <% end %>
  </div>

  <% if alert = flash[:alert] %>
    <p class="mt-4 rounded-lg bg-red-500/10 text-red-400 font-medium px-4 py-2 text-sm border border-red-500/30 max-w-xl mx-auto">
      <%= alert %>
    </p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="mt-4 rounded-lg bg-green-500/10 text-green-400 font-medium px-4 py-2 text-sm border border-green-500/30 max-w-xl mx-auto">
      <%= notice %>
    </p>
  <% end %>
</div>
