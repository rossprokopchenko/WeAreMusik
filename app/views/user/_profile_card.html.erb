<!-- profile image -->
<div data-controller="profile-picture" class="relative w-full rounded-t-2xl">
  <div class="relative flex justify-center items-end h-40">
      
      <!-- Circle background -->
      <div data-profile-picture-target="circle"
          class="absolute inset-0 bg-gray-200 dark:bg-gray-800 duration-500 rounded-b-[6rem] transition-colors rounded-t-2xl z-0">
      </div>

      <!-- Visible profile image -->
      <%= image_tag(@user.profile_picture.presence || "default_avatar.jpg",
          class: "w-32 h-32 rounded-full border-4 border-gray-900 dark:border-gray-900 shadow-lg z-10 relative mb-5",
          data: { "profile-picture-target": "visibleImage" }) %>

      <!-- Hidden clone for color analysis -->
      <%= image_tag(@user.profile_picture.presence || "default_avatar.jpg",
          style: "display: none",
          crossorigin: "anonymous",
          data: { "profile-picture-target": "hiddenImage" }) %>
  </div>
</div>



<!-- Profile info -->
<div class="flex flex-col pt-18 px-6 w-full h-full">
    <div class="text-xl font-semibold text-white">
        <%= @user.username %>
    </div>

    <div>
        <div class="flex items-center space-x-2 mt-1">
            <% @user.user_social_links.each do |link| %>
            <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300">
                <%= image_tag("icons/#{link.platform}.svg", class: "w-5 h-5") %>
            </a>
            <% end %>
        </div>
    </div>

    <div>
        <div class="flex items-center space-x-2 mt-2">
            <span class="text-sm text-gray-400 dark:text-gray-300">
                <%= @user.followers.count %> Followers
            </span>
            <span class="text-sm text-gray-400 dark:text-gray-300">
                <%= @user.following.count %> Following
            </span>
        </div>
    </div>

    <div class="text-sm text-gray-300 dark:text-gray-300 mt-4">
        <%= @user.biography.body %>
    </div>

    <div class="">
        <button onclick="location.href=''" class="mt-9 flex items-center cursor-pointer w-full px-4 py-2 font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-500 focus:outline-none focus:ring focus:ring-blue-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
        </svg>
        <span class="mx-auto">Follow</span>
        </button>
    </div>

    <div class="flex justify-center items-center space-x-4 my-auto">
        <div class="flex flex-col items-center px-4 py-2 rounded-lg">
            <span class="text-lg font-semibold text-white text-center">
                <%= @user.saved_releases.count %>
            </span>
            <span class="text-sm text-gray-400 dark:text-gray-300 text-center">
                Saved Albums
            </span>
        </div>
        <div class="flex flex-col items-center px-4 py-2 rounded-lg">
            <span class="text-lg font-semibold text-white text-center">
                <%= @user.saved_artists.count %>
            </span>
            <span class="text-sm text-gray-400 dark:text-gray-300 text-center">
                Saved Artists
            </span>
        </div>
        <div class="flex flex-col items-center px-4 py-2 rounded-lg">
            <span class="text-lg font-semibold text-white text-center">
                <%= @user.liked_tracks.count %>
            </span>
            <span class="text-sm text-gray-400 dark:text-gray-300 text-center">
                Liked Tracks
            </span>
        </div>
    </div>
</div>

<!-- Edit profile link -->
<div class="mt-auto mb-6 mx-auto">
    <a href=<%= edit_user_path(@user) %> class="text-blue-400 underline hover:text-blue-300">
        Edit profile
    </a>
</div>