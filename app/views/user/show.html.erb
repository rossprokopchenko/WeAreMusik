<% cache @user do %>
    <div class="">
        <div class="flex flex-row w-full">
            <div class="text-2xl font-bold">
                <%= @user.username %>'s Profile
            </div>

            <button onclick="location.href='<%= edit_user_path(@user) %>'" class="ml-5 flex items-center px-4 py-2 font-medium tracking-wide text-white capitalize transition-colors duration-300 transform bg-blue-600 rounded-lg hover:bg-blue-500 focus:outline-none focus:ring focus:ring-blue-300 focus:ring-opacity-80">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                </svg>

                <span class="mx-2">Edit</span>
            </button>
        </div>

        <%# <%= button_to "Delete", edit_profile_path(@user), user: @user, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
        
        <div class="flex flex-col w-full mt-4">
            <div class="flex flex-row">
                <%= image_tag @user.profile_picture, class: "w-32 h-32" %>
            </div>

            <div class="mt-2">
                <%= @user.biography.body %>
            </div>

            <div class="mt-2">
                Created at: <%= @user.created_at %>
            </div>
        </div>

    </div>
<% end %>