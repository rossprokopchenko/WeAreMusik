<!-- Favourite Albums -->
<% if @favorite_releases.present? %>
  <div>
    <div class="flex flex-row">
      <div class="text-xl text-white font-semibold">
        Favourite Albums
      </div>

      <div class="ml-auto">
        <a href="#" class="underline text-blue-400 hover:text-blue-300">See all</a>
      </div>
    </div>

    <div class="mt-2 h-64 py-4">
      <div class="flex w-full h-full space-x-4 max-w-5xl mx-auto">
        <% @favorite_releases.limit(5).each do |release| %>
          <div class="flex flex-col rounded-xl flex-1 min-w-0">
            <div
              data-controller="cover-art"
              data-cover-art-cover-url="<%= url_for(release.cover_art) if release.cover_art.attached? %>"
              data-cover-art-target="coverContainer"
              class="w-full relative rounded-xl overflow-hidden bg-gray-800"
              style="padding-top: 100%;"
            >
              <!-- Skeleton Placeholder -->
              <div class="cover-skeleton rounded-xl bg-gray-700 animate-pulse absolute inset-0"></div>
            </div>

            <div class="text-sm text-white font-semibold truncate mt-2">
              <%= release.name %>
            </div>
            <div class="text-xs text-gray-400 truncate">
              <%= release.artist_credit&.name %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="flex flex-row">
    <div class="text-xl text-white">
      No Favourite Albums
    </div>
  </div>
<% end %>



<!-- Favourite Artists -->
<% if @favorite_artists.present? %>
    <div class="flex flex-row">
        <div class="text-xl text-white">
            Favourite Artists
        </div>

        <div class="ml-auto">
            <a href="#" class="underline text-blue-400 hover:text-blue-300">See all</a>
        </div>
    </div>

    <div class="flex flex-row w-full mt-2 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 h-64">
        <!-- Content here -->
        <div class="flex flex-row overflow-x-scroll space-x-4 p-4">
            <% @favorite_artists.each do |artist| %>
                <div class="w-40 flex-shrink-0 bg-gray-800 rounded-xl p-2">
                    <div class="text-sm text-white font-semibold truncate">
                        <%= artist.name %>
                    </div>
                    <div class="text-xs text-gray-400 truncate">
                        <%= artist.genre %>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
<% else %>
    <div class="flex flex-row">
        <div class="text-xl text-white">
        No Favourite Artists
        </div>
    </div>
<% end %>

