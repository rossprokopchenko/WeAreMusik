<%= turbo_frame_tag "user_stats_#{user.gid}" do %>
  <div class="flex items-center space-x-2 mt-2">
    <div>
      <span class="text-sm text-gray-400 dark:text-gray-300">
        <%= user.followers.count %> followers
      </span>
    </div>
    <div>
      <span class="text-sm text-gray-400 dark:text-gray-300">
        <%= user.following.count %> following
      </span>
    </div>
  </div>
<% end %>
