<div id="follow_button_<%= user.id %>">
  <% if current_user.following.include?(user) %>
    <%= button_to unfollow_user_path(user), method: :delete, class: "w-full px-4 py-2 border border-red-600 text-red-600 hover:bg-red-50 hover:text-red-700 rounded-lg cursor-pointer transition" do %>
        Unfollow
    <% end %>
  <% else %>
    <%= button_to follow_user_path(user), method: :post, class: "w-full px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg cursor-pointer" do %>
      Follow
    <% end %>
  <% end %>
</div>