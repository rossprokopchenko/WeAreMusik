<!-- Favourite Albums -->
<% if @favorite_releases.present? %>
  <div data-controller="favorite-releases">
    <div class="flex flex-row">
      <div class="text-xl text-white font-semibold">Favourite Albums</div>

      <div class="ml-auto">
        <button
          type="button"
          data-action="click->favorite-releases#toggle"
          data-favorite-releases-target="seeAllButton"
          class="underline text-blue-400 hover:text-blue-300 bg-transparent border-none cursor-pointer"
        >
          See all
        </button>
      </div>
    </div>

    <div class="mt-2 py-4 overflow-y-auto max-w-5xl mx-auto space-y-4">

      <% @favorite_releases.limit(5).each_slice(5) do |slice| %>
        <div class="flex w-full h-full space-x-4">
          <% slice.each do |release| %>
            <%= render partial: "release_card", locals: { release: release } %>
          <% end %>
        </div>
      <% end %>

      <% extra_releases = @favorite_releases.offset(5) %>

      <% extra_releases.each_slice(5) do |slice| %>
        <div
          class="flex w-full h-full space-x-4"
          data-favorite-releases-target="extraRelease"
          style="display: none;"
        >
          <% slice.each do |release| %>
            <%= render partial: "release_card", locals: { release: release } %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>

<% else %>
  <div class="flex flex-row">
    <div class="text-xl text-white">No Favourite Albums</div>
  </div>
<% end %>

<div class="w-full h-[1] rounded-xl bg-slate-600"></div>

<!-- Favourite Artists -->
<% if @favorite_artists.present? %>
  <div class="mt-6" data-controller="favorite-artists">
    <div class="flex flex-row">
      <div class="text-xl text-white font-semibold">Favourite Artists</div>

      <div class="ml-auto">
        <button
          type="button"
          data-action="click->favorite-artists#toggle"
          data-favorite-artists-target="seeAllButton"
          class="underline text-blue-400 hover:text-blue-300 bg-transparent border-none cursor-pointer"
        >
          See all
        </button>
      </div>
    </div>

    <div class="mt-2 py-4 overflow-y-auto max-w-5xl mx-auto space-y-4">

      <% @favorite_artists.limit(5).each_slice(5) do |slice| %>
        <div class="flex w-full h-full space-x-4">
          <% slice.each do |artist| %>
            <%= render partial: "common/artist_card", locals: { artist: artist } %>
          <% end %>
        </div>
      <% end %>

      <% extra_artists = @favorite_artists.offset(5) %>

      <% extra_artists.each_slice(5) do |slice| %>
        <div
          class="flex w-full h-full space-x-4"
          data-favorite-artists-target="extraArtist"
          style="display: none;"
        >
          <% slice.each do |artist| %>
            <%= render partial: "common/artist_card", locals: { artist: artist } %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
<% else %>
  <div class="flex flex-row">
    <div class="text-xl text-white">No Favourite Artists</div>
  </div>
<% end %>
